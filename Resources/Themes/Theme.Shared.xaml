<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Typography  -->
    <FontFamily x:Key="Typography.FontFamily.Base">Segoe UI, Inter, Arial</FontFamily>
    <sys:Double x:Key="Typography.FontSize.H1">24</sys:Double>
    <sys:Double x:Key="Typography.FontSize.H2">18</sys:Double>
    <sys:Double x:Key="Typography.FontSize.H3">16</sys:Double>
    <sys:Double x:Key="Typography.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Typography.FontSize.Small">10</sys:Double>

    <!--  Splash Screen  -->
    <SolidColorBrush x:Key="Brush.SplashScreen.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SplashScreen" Color="#262b3a" />
    <SolidColorBrush x:Key="Brush.SplashScreen.Border" Color="#151820" />

    <!--  Top Bar  -->
    <GridLength x:Key="Layout.TopBar.Height">65</GridLength>

    <!--  Navigation  -->
    <sys:Double x:Key="Layout.Navigation.Width">200</sys:Double>

    <Style BasedOn="{StaticResource {x:Type ui:ContentDialog}}" TargetType="{x:Type ui:ContentDialog}">
        <Setter Property="Border.CornerRadius" Value="6" />
        <Setter Property="Padding" Value="15" />
    </Style>

    <!--  Content  -->
    <Style
        x:Key="Content.Label"
        BasedOn="{StaticResource {x:Type Label}}"
        TargetType="{x:Type Label}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Typography.FontSize.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style
        x:Key="Content.UnderLabel"
        BasedOn="{StaticResource {x:Type Label}}"
        TargetType="{x:Type Label}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Typography.FontSize.H3}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <!--  Form  -->
    <Style
        x:Key="Form.LabelStyle"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">

        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="FontWeight" Value="SemiBold" />

    </Style>

    <Style
        x:Key="Form.TextBoxStyle"
        BasedOn="{StaticResource {x:Type ui:TextBox}}"
        TargetType="ui:TextBox">

        <Setter Property="Width" Value="400" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,15" />

    </Style>

    <Style
        x:Key="Form.ComboBoxStyle"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">

        <Setter Property="Width" Value="400" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="IsEditable" Value="False" />

    </Style>

    <Style
        x:Key="Form.NumberBoxStyle"
        BasedOn="{StaticResource {x:Type ui:NumberBox}}"
        TargetType="ui:NumberBox">

        <Setter Property="Width" Value="400" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,15" />

    </Style>

    <!--  Dialog  -->
    <Style
        x:Key="CustomContentDialogStyle"
        BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
        TargetType="{x:Type ui:ContentDialog}" />

    <Style
        x:Key="DarkContentDialogStyle"
        BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
        TargetType="{x:Type ui:ContentDialog}">

        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource Brush.Content}" />
        <Setter Property="Border.BorderBrush" Value="{DynamicResource Brush.Content.Border}" />

        <Style.Resources>
            <SolidColorBrush x:Key="ContentDialogForeground" Color="#FFFFFF" />
        </Style.Resources>

    </Style>

</ResourceDictionary>
