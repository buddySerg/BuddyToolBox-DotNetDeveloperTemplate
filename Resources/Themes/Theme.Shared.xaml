<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  region: Typography  -->
    <FontFamily x:Key="Typography.FontFamily.Base">Segoe UI, Inter, Arial</FontFamily>
    <sys:Double x:Key="Typography.FontSize.H1">24</sys:Double>
    <sys:Double x:Key="Typography.FontSize.H2">18</sys:Double>
    <sys:Double x:Key="Typography.FontSize.H3">16</sys:Double>
    <sys:Double x:Key="Typography.FontSize.Body">14</sys:Double>
    <sys:Double x:Key="Typography.FontSize.Small">10</sys:Double>

    <!--  region: Splash Screen  -->
    <SolidColorBrush x:Key="Brush.SplashScreen.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SplashScreen" Color="#262b3a" />
    <SolidColorBrush x:Key="Brush.SplashScreen.Border" Color="#151820" />

    <!--  region: Top Bar  -->
    <GridLength x:Key="Layout.TopBar.Height">65</GridLength>

    <!--  region: Navigation  -->
    <sys:Double x:Key="Layout.Navigation.Width">200</sys:Double>

    <!--  region: Content  -->
    <Style
        x:Key="Content.Label"
        BasedOn="{StaticResource {x:Type Label}}"
        TargetType="{x:Type Label}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Typography.FontSize.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="Content.UnderLabel"
        BasedOn="{StaticResource {x:Type Label}}"
        TargetType="{x:Type Label}">
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource Typography.FontSize.H3}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  region : Forms  -->
    <!--  TextBlock  -->
    <Style
        x:Key="Form.LabelStyle"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,15" />
    </Style>

    <!--  ui:TextBox  -->
    <Style
        x:Key="Form.TextBoxStyle"
        BasedOn="{StaticResource {x:Type ui:TextBox}}"
        TargetType="ui:TextBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="400" />
        <Setter Property="Margin" Value="0,0,0,15" />
    </Style>

    <!--  ComboBox  -->
    <Style
        x:Key="Form.ComboBoxStyle"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="400" />
        <Setter Property="Margin" Value="0,0,0,15" />
        <Setter Property="IsEditable" Value="False" />
    </Style>

    <!--  ui:NumberBox  -->
    <Style
        x:Key="Form.NumberBoxStyle"
        BasedOn="{StaticResource {x:Type ui:NumberBox}}"
        TargetType="ui:NumberBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="400" />
        <Setter Property="Margin" Value="0,0,0,15" />
    </Style>

    <!--  region : Dialog  -->
    <!--  ui:ContentDialog  -->
    <Style
        x:Key="Dialog.BaseStyle"
        BasedOn="{StaticResource {x:Type ui:ContentDialog}}"
        TargetType="{x:Type ui:ContentDialog}">
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  region : DataGrid  -->
    <!--  ui:DataGrid  -->
    <Style
        x:Key="DataGrid.BaseStyle"
        BasedOn="{StaticResource {x:Type ui:DataGrid}}"
        TargetType="{x:Type ui:DataGrid}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <!--  Apply the base style to every ui:DataGrid.  -->
    <Style BasedOn="{StaticResource DataGrid.BaseStyle}" TargetType="{x:Type ui:DataGrid}" />

    <!--  region : Card  -->
    <!--  ui:Card  -->
    <Style
        x:Key="Card.BaseStyle"
        BasedOn="{StaticResource {x:Type ui:Card}}"
        TargetType="{x:Type ui:Card}">
        <Setter Property="Padding" Value="15" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!--  ui:Card / Grid  -->
    <Style
        x:Key="Card.GridStyle"
        BasedOn="{StaticResource {x:Type ui:Card}}"
        TargetType="{x:Type ui:Card}">
        <Setter Property="Padding" Value="5" />
        <Setter Property="Border.CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!--  region : Navigation  -->
    <Style x:Key="Navigation.Bottom" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

</ResourceDictionary>
