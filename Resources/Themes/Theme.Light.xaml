<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Window  -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#ffffff" />

    <!--  TopBar  -->
    <SolidColorBrush x:Key="Brush.TopBar" Color="#262b3b" />
    <SolidColorBrush x:Key="Brush.TopBar.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TopBar.Border" Color="#1e222e" />

    <!--  Navigation  -->
    <SolidColorBrush x:Key="Brush.Navigation" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Navigation.Border" Color="#FFFFFF" />

    <!--  Content  -->
    <SolidColorBrush x:Key="Brush.Content" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Content.Border" Color="Gray" />

    <!--  ui:ContentDialog  -->
    <Style BasedOn="{StaticResource Dialog.BaseStyle}" TargetType="{x:Type ui:ContentDialog}" />

    <!--  ui:Card  -->
    <Style BasedOn="{StaticResource Card.BaseStyle}" TargetType="{x:Type ui:Card}" />

    <Style
        x:Key="Card.GridStyle"
        BasedOn="{StaticResource Card.GridBaseStyle}"
        TargetType="{x:Type ui:Card}" />

</ResourceDictionary>