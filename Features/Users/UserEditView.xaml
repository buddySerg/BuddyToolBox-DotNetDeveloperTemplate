<UserControl
    x:Class="BTB.Features.Users.UserEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource Brush.Content}" SnapsToDevicePixels="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  TopBar  -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
                Grid.Column="0"
                Margin="0,5,0,5"
                Content="{Binding Title}"
                Style="{StaticResource Content.Label}" />

        </Grid>

        <!--  Content  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            CanContentScroll="True"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Top">

                <Grid Grid.IsSharedSizeScope="True">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Labels" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Gender]}" />

                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="2"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding Genders}"
                        SelectedValue="{Binding User.Gender}"
                        SelectedValuePath="Key"
                        Style="{StaticResource Form.ComboBoxStyle}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.FirstName]}" />
                    <ui:TextBox
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.FirstName}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.LastName]}" />
                    <ui:TextBox
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.LastName}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Initials]}" />
                    <ui:TextBox
                        Grid.Row="3"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.Initials}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Email]}" />
                    <ui:TextBox
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.Email}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Phone]}" />
                    <ui:TextBox
                        Grid.Row="5"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.Phone, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Street]}" />
                    <ui:TextBox
                        Grid.Row="6"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.Street}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.ZipCode]}" />
                    <ui:TextBox
                        Grid.Row="7"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.ZipCode}" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.City]}" />
                    <ui:TextBox
                        Grid.Row="8"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.City}" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Country]}" />
                    <ui:TextBox
                        Grid.Row="9"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.Country}" />

                    <CheckBox
                        Grid.Row="10"
                        Grid.Column="2"
                        Margin="-10,0,0,10"
                        Content="{Binding Translate[Features.Users.Active]}"
                        IsChecked="{Binding User.IsActive}" />

                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.Role]}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox
                        Grid.Row="11"
                        Grid.Column="2"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding Roles}"
                        SelectedValue="{Binding User.Role}"
                        SelectedValuePath="Key"
                        Style="{StaticResource Form.ComboBoxStyle}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Grid.Row="12"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Features.Users.UserName]}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:TextBox
                        Grid.Row="12"
                        Grid.Column="2"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Text="{Binding User.UserName}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Grid.Row="13"
                        Grid.Column="0"
                        Style="{StaticResource Form.LabelStyle}"
                        Text="{Binding Translate[Common.Password]}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:PasswordBox
                        Grid.Row="13"
                        Grid.Column="2"
                        Password="{Binding User.NewPassword}"
                        Style="{StaticResource Form.TextBoxStyle}"
                        Visibility="{Binding ShowAuthenticationData, Converter={StaticResource BooleanToVisibilityConverter}}" />

                </Grid>

            </ui:Card>

        </ScrollViewer>

        <!--  Bottom Buttons  -->
        <StackPanel Grid.Row="2" Style="{StaticResource Navigation.Bottom}">
            <ui:Button
                Appearance="Primary"
                Command="{Binding SaveCommand}"
                Content="{Binding Translate[Common.Save]}"
                Icon="{ui:SymbolIcon Symbol=Save20}" />
            <ui:Button
                Margin="10,0,0,0"
                Command="{Binding CancelCommand}"
                Content="{Binding Translate[Common.Cancel]}"
                Icon="{ui:SymbolIcon Symbol=Dismiss20}" />
        </StackPanel>

    </Grid>

</UserControl>