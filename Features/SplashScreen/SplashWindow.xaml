<Window
    x:Class="BTB.Features.SplashScreen.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500"
    Height="400"
    AllowsTransparency="False"
    Background="Transparent"
    Foreground="{StaticResource Brush.SplashScreen.Text}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="{DynamicResource Brush.SplashScreen}"
        BorderBrush="{DynamicResource Brush.SplashScreen.Border}"
        BorderThickness="1"
        ClipToBounds="True"
        CornerRadius="1"
        SnapsToDevicePixels="True">

        <!--  Top Bar  -->
        <Grid Background="{DynamicResource Brush.SplashScreen}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource Layout.TopBar.Height}" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.TopBar}">
                <Grid>
                    <Image
                        Height="50"
                        Margin="5,5,0,0"
                        HorizontalAlignment="Left"
                        Source="/Resources/Images/Logo.png" />
                    <TextBlock
                        Margin="75,40,0,0"
                        FontSize="10"
                        Foreground="{DynamicResource Brush.TopBar.Text}"
                        Text="{Binding Translate[App.Quote]}" />
                    <Border
                        Width="25"
                        Margin="245,5,0,0"
                        Padding="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#0199ea"
                        CornerRadius="4">

                        <TextBlock
                            FontSize="10"
                            Foreground="{DynamicResource Brush.TopBar.Text}"
                            Text="{Binding AppVersion}" />
                    </Border>
                    <Rectangle
                        Grid.ColumnSpan="3"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Fill="{DynamicResource Brush.TopBar.Border}" />
                </Grid>
            </Border>

            <!--  Center Content  -->
            <StackPanel
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource Brush.SplashScreen}">

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock FontWeight="Medium" Text="{Binding Translate[App.Name]}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        FontWeight="Medium"
                        Text="{Binding AppVersion, StringFormat=(Version: {0})}" />
                </StackPanel>

                <TextBlock
                    Margin="0,10,0,0"
                    Text="{Binding Translate[App.Description]}"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,10,0,0" Text="{Binding Copyright}" />

            </StackPanel>

            <Grid Grid.Row="2">
                <StackPanel Margin="10">
                    <ProgressBar
                        Height="10"
                        Margin="0,0,0,10"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding Status.Progress}" />
                    <TextBlock FontSize="12" Text="{Binding StatusText}" />
                </StackPanel>
            </Grid>
        </Grid>

    </Border>
</Window>
