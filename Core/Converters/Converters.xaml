<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:BTB.Core.Converters">

    <!--  Converts true to false and false to true.  -->
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />

    <!--  Converts true to Collapsed and false to Visible.  -->
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    <!--  Converts enum values to localized strings.  -->
    <converters:LocalizedEnumConverter x:Key="LocalizedEnumConverter" />

</ResourceDictionary>
