<Application
    x:Class="BTB.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Application.Resources>
        <ResourceDictionary>

            <!--  Merged Dictionaries  -->
            <ResourceDictionary.MergedDictionaries>

                <!--  Base / Core  -->
                <ResourceDictionary Source="/Core/Converters/Converters.xaml" />

                <!--
                    Resource precedence:
                    1. Framework defaults
                    2. Dark theme
                    3. Shared application overrides
                -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Resources/Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="/Resources/Themes/Theme.Shared.xaml" />

                <!--  Icons and Images  -->
                <ResourceDictionary Source="/Resources/IconAndImageResources.xaml" />

                <!--  DataTemplates  -->
                <ResourceDictionary Source="/Resources/DataTemplateResources.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>

    </Application.Resources>

</Application>
